# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=gytf7gmz
CLOUDINARY_API_KEY=233416524174115
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Google Gemini API (proxied through backend — never exposed to client)
