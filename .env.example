# Firebase Service Account (for FCM push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# Admin Portal URL (for cross-service communication)
ADMIN_PORTAL_URL=http://localhost:3000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
